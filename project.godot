; Engine configuration file.
; Generated for Space Dogfighter
config_version=5

[application]
config/name="Última Ronda"
config/icon="res://assets/share/favicon_runtime.png"
config/custom_user_dir_name="UltimaRonda"
config/use_custom_user_dir=true
run/main_scene="res://scenes/title_screen.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.012, 0.025, 0.023, 1)
boot_splash/show_image=false

[autoload]
ManusAuth="*res://scripts/manus_auth.gd"

TuningBridge="*res://scripts/manus/preview/tuning_adapter.gd"

ManusFontTheme="*res://autoload/manus_font_theme.gd"
I18n="*res://autoload/i18n.gd"
TuningStore="*res://autoload/tuning_store.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[gui]

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.008, 0.006, 0.02, 1)
textures/default_filters/use_nearest_mipmap_filter=false

[audio]
driver/enable_input=false

[editor]
import/use_multiple_threads=false
